# Identidad de la app
APP_NAME=EnergyFlow API

# Entorno: dev | staging | prod
# En 'prod' se ocultan /docs y /redoc.
ENV=dev

# Prefijo base de la API
API_PREFIX=/api/v1

# Seguridad JWT
# JWT_SECRET_KEY: usar una cadena fuerte (>=32 chars) en producción.
# Generar por ejemplo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_this_secret_min_16_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Conexión MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=energyflow

# CORS: lista de orígenes permitidos separados por coma (sin espacios extra)
CORS_ORIGINS=http://localhost:3000

# CORS regex (opcional): expresión para permitir orígenes dinámicos.
# Por defecto está desactivado (vacío). Solo configurarlo si se necesitan
# múltiples subdominios o previews dinámicos. Ejemplos:
#   - Subdominios propios:  https://([a-z0-9-]+\.)?tu-dominio\.com
#   - Vercel previews:      https://.*\.vercel\.app
# CORS_ORIGIN_REGEX=

# Auth via cookie HttpOnly (sustituye almacenamiento del token en localStorage)
AUTH_COOKIE_NAME=energyflow_session
# AUTH_COOKIE_DOMAIN: dejar vacío para usar el host actual. Setear sólo si
# frontend y backend viven en subdominios distintos (ej. .tu-dominio.com).
# AUTH_COOKIE_DOMAIN=
# SameSite: 'lax' (default), 'strict' o 'none'. 'none' requiere HTTPS.
AUTH_COOKIE_SAMESITE=lax
# El flag Secure se activa automáticamente cuando ENV=prod o production.
