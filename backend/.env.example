# Identidad de la app
APP_NAME=EnergyFlow API

# Entorno: dev | staging | prod
# En 'prod' se ocultan /docs y /redoc.
ENV=dev

# Prefijo base de la API
API_PREFIX=/api/v1

# Seguridad JWT
# JWT_SECRET_KEY: usar una cadena fuerte (>=32 chars) en producción.
# Generar por ejemplo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_this_secret_min_16_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Conexión MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=energyflow

# CORS: lista de orígenes permitidos separados por coma (sin espacios extra)
CORS_ORIGINS=http://localhost:3000

# CORS regex (opcional): expresión para permitir orígenes dinámicos.
# Ejemplos:
#   - Vercel previews: https://.*\.vercel\.app
#   - Solo tu dominio:  https://(www\.)?tu-dominio\.com
# Dejar vacío para desactivarlo.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
